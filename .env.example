# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority&appName=streamx
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority&appName=streamx

# Session
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# Admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=

# HuggingFace (optional)
HF_TOKEN=

# YouTube (optional)
YOUTUBE_API_KEY=

# SMTP Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Video Storage (optional)
VIDEO_STORAGE_BASE=
